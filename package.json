{
	"name": "create-packkit-go",
	"version": "0.4.0",
	"description": "Scaffold modern Go projects — go.mod modules, idiomatic layout, table tests — from a CLI or the browser. Packkit's Go generator.",
	"homepage": "https://github.com/PackkitLabs/create-packkit-go#readme",
	"bugs": {
		"url": "https://github.com/PackkitLabs/create-packkit-go/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PackkitLabs/create-packkit-go.git"
	},
	"license": "MIT",
	"author": "DanMat <dannymatthew@gmail.com>",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"create-packkit-go": "./dist/cli.js"
	},
	"files": [
		"dist",
		"src"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "tsup",
		"dev": "tsup --watch",
		"prepublishOnly": "tsup",
		"clean": "rimraf dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepare": "simple-git-hooks",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "npm run build && changeset publish",
		"check:pkg": "publint && attw --pack --profile esm-only",
		"check:freshness": "npm run build && node scripts/check-freshness.mjs",
		"check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:pkg",
		"test:integration": "npm run build && node scripts/integration.mjs"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*.{js,ts}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md,yml}": "prettier --write"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.0",
		"@changesets/cli": "^2.27.0",
		"@eslint/js": "^10.0.0",
		"@types/node": "^24.0.0",
		"@vitest/coverage-v8": "^4.0.0",
		"eslint": "^10.0.0",
		"globals": "^17.11.0",
		"lint-staged": "^16.2.0",
		"prettier": "^3.3.0",
		"publint": "^0.3.0",
		"rimraf": "^6.0.0",
		"simple-git-hooks": "^2.11.0",
		"tsup": "^8.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.0.0",
		"vitest": "^4.0.0"
	},
	"dependencies": {
		"@packkit/core": "^0.4.0"
	}
}
